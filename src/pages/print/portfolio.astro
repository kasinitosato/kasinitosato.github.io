---
// A two-page highlights version of the portfolio for job applications
// (letter landscape), in the same look as the site. Not linked from the site menus. To make the PDF, run
// `npm run portfolio-pdf` (builds the site, then prints this page with Chrome).
//
// Page 1: the first two featured projects.
// Page 2: the third featured project, the Punahou Go-Kart and a strip of more projects.
// Featured projects and their measured results come from src/lib/featured.ts;
// the Go-Kart card is written below (Punahou pages have no summary or role fields),
// and the strip's projects are listed in `more`.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { site } from '../../lib/site';
import { featured } from '../../lib/featured';
import goKartPhoto from '../../assets/featured/go-kart.jpg';
// The rope robot's cover (plush passengers) reads as a toy at this size; the gear train shows the build
import gearTrain from '../../content/projects/rope-climbing-robot/09_gear_train_top_view.jpg';
const coverOverride: Record<string, { image: ImageMetadata; position?: string }> = {
  'rope-climbing-robot': { image: gearTrain, position: '60% 50%' },
};

const siteHost = 'kasinitosato.github.io';
const more = ['sae-aero', 'toggle-clamp-dfm', 'hydraulic-system', 'heat-sink'];

const project = async (slug: string) => {
  const entry = await getEntry('projects', slug);
  if (!entry) throw new Error(`Project "${slug}" not found in src/content/projects/`);
  return entry;
};

type Card = {
  slug: string;
  eyebrow: string;
  title: string;
  summary?: string;
  results?: { label: string; value: string }[];
  note?: string;
  highlights?: string[];
  role?: string;
  tools: string[];
  cover: ImageMetadata;
  coverPosition?: string;
};

// From src/content/punahou/engineering-iii/go-kart/
const goKart: Card = {
  slug: 'punahou/engineering-iii/go-kart',
  eyebrow: 'Punahou School · Engineering III',
  title: 'Go-Kart',
  summary:
    'A four-person team build of a go-kart in six weeks, from a kit and 2 x 1 in aluminum rectangular tubing: research, sketches, CAD, chassis, drive, steering and brakes.',
  highlights: [
    'Reworked chassis bars when the brackets had off-set holes, and made and welded our own turning mechanism when the kit parts were too long.',
    'Took the 3D printed steering wheel cap through three prints: the first came out as two weak pieces, the second broke from too little infill, the third held.',
  ],
  role: 'Designed the drive\'s axle mount bearing, brake disc mount, sprocket mount and spacers, and the steering wheel cap body.',
  tools: ['CAD', 'Chassis Fabrication', 'Welding', 'Drilling', '3D Printing', 'Drive and Steering Systems'],
  cover: goKartPhoto,
};

const featuredCards: Card[] = await Promise.all(
  featured.map(async (f) => {
    const { data } = await project(f.slug);
    if (!data.cover) throw new Error(`Featured project "${f.slug}" needs a cover photo`);
    return {
      slug: `projects/${f.slug}`,
      eyebrow: [data.course, data.date].filter(Boolean).join(' · '),
      title: data.title,
      summary: data.summary,
      results: f.results,
      note: f.note,
      role: data.role,
      tools: data.tools.slice(0, 7),
      cover: coverOverride[f.slug]?.image ?? data.cover,
      coverPosition: coverOverride[f.slug]?.position ?? data.coverPosition,
    };
  }),
);

const moreProjects = await Promise.all(more.map(async (slug) => ({ slug, ...(await project(slug)).data })));
const allCards = [...featuredCards, goKart];
const pages = [allCards.slice(0, 2), allCards.slice(2, 4)];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{site.name} | Portfolio Highlights</title>
  </head>
  <body>
    {pages.map((cards, pi) => (
      <section class="page">
        {pi === 0 && (
          <header class="masthead">
            <div class="who">
              <h1>{site.name}</h1>
              <p class="role-line">Mechanical Engineer</p>
              <p class="degree">BS Mechanical Engineering, Loyola Marymount University · May 2027</p>
            </div>
            <!-- The same facts as the title block on the home page, plus how to reach me -->
            <dl class="title-block">
              <div><dt>Graduates</dt><dd>May 2027</dd></div>
              <div><dt>FE exam</dt><dd>Mechanical, November 2026</dd></div>
              <div><dt>Based in</dt><dd>Los Angeles, CA</dd></div>
              <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
              <div><dt>LinkedIn</dt><dd><a href={site.linkedin}>in/kasin-ito-sato</a></dd></div>
              <div><dt>Portfolio</dt><dd><a href={`https://${siteHost}`}>{siteHost}</a></dd></div>
            </dl>
          </header>
        )}

        <div class="cards">
          {cards.map((c) => (
            <article class="card">
              <figure class="photo">
                <Image src={c.cover} alt="" width={1400} quality={78} format="jpg" loading="eager" style={c.coverPosition ? `object-position: ${c.coverPosition}` : undefined} />
              </figure>
              <div class="body">
                <p class="label">{c.eyebrow}</p>
                <h2><a href={`https://${siteHost}/${c.slug}/`}>{c.title}</a></h2>
                {c.summary && <p class="summary">{c.summary}</p>}
                {c.results && (
                  <div class="result">
                    <dl style={`grid-template-columns: repeat(${c.results.length}, 1fr)`}>
                      {c.results.map((r) => (
                        <div><dt>{r.label}</dt><dd>{r.value}</dd></div>
                      ))}
                    </dl>
                    {c.note && <p>{c.note}</p>}
                  </div>
                )}
                {c.highlights && (
                  <ul class="highlights">
                    {c.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
                {c.role && <p class="role"><strong>My role.</strong> {c.role}</p>}
                <ul class="tags">
                  {c.tools.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>

        {pi === 1 && (
          <aside class="more">
            <h2>More projects <a href={`https://${siteHost}/projects/`}>{siteHost}/projects</a></h2>
            <ul>
              {moreProjects.map((p) => (
                <li>
                  <a href={`https://${siteHost}/projects/${p.slug}/`}>{p.title}</a>
                  <span>{p.summary}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}

        <footer>
          <span class="mark">{site.name}</span>
          <span>Portfolio highlights · {pi + 1} of {pages.length}</span>
        </footer>
      </section>
    ))}
  </body>
</html>

<!-- The site's look (src/styles/global.css): paper, graphite, Newsreader headings,
     Archivo text, IBM Plex Mono for labels and measurements, square edges and hairline rules -->
<style is:global>
  @page { size: 11in 8.5in; margin: 0; }

  :root {
    --ink: #1a1918;
    --charcoal: #2f2d2a;
    --steel: #5e5a53;
    --mist: #d4ccbf;
    --paper: #f3efe7;
    --paper-up: #e8e2d6;
    --graphite: #151515;
    --font: 'Archivo Variable', 'Helvetica Neue', Arial, sans-serif;
    --serif: 'Newsreader Variable', Georgia, serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
  }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    margin: 0;
    background: #8a867f;
    color: var(--charcoal);
    font: 9.2pt/1.45 var(--font);
  }
  @media print { body { background: none; } }
  ::selection { background: var(--ink); color: var(--paper); }
  p, li, dd { text-wrap: pretty; } /* no single word left alone on the last line */
  a { color: inherit; text-decoration: none; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  figure { margin: 0; }
  ul, dl { margin: 0; padding: 0; list-style: none; }
  dd { margin: 0; }
  h1, h2 { color: var(--ink); font-family: var(--serif); font-optical-sizing: auto; font-weight: 380; margin: 0; }

  .page {
    width: 11in;
    height: 8.5in;
    padding: 0.45in 0.5in 0.6in;
    background: var(--paper);
    position: relative;
    overflow: hidden;
    break-after: page;
    margin: 0 auto 0.25in;
    display: flex;
    flex-direction: column;
    gap: 0.24in;
  }
  @media print { .page { margin: 0; } }

  /* Mono capitals, the way a drawing prints its labels */
  .label, .title-block dt, .result dt, footer {
    font-family: var(--mono);
    font-size: 6.8pt;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--steel);
  }

  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.4in;
    padding-bottom: 0.2in;
    border-bottom: 1px solid var(--ink);
  }
  .masthead h1 { font-size: 40pt; line-height: 0.95; letter-spacing: -0.035em; margin-bottom: 0.1in; }
  .role-line { margin: 0; font-size: 11pt; font-weight: 650; color: var(--ink); }
  .degree { margin: 0.02in 0 0; font-size: 10pt; color: var(--charcoal); }

  /* Engineering title block: ruled cells, label over value */
  .title-block {
    display: grid;
    grid-template-columns: 1.05fr 1.4fr 1.25fr;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--mist);
    flex: none;
  }
  .title-block div { padding: 0.05in 0.09in 0.06in; border-right: 1px solid var(--mist); border-bottom: 1px solid var(--mist); }
  .title-block dt { margin-bottom: 0.01in; }
  .title-block dd { font-size: 8.6pt; color: var(--ink); white-space: nowrap; }

  /* Cards side by side share rows, so their photos match in height and their titles line up */
  .cards { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: minmax(1.5in, 1fr) auto; column-gap: 0.34in; }
  .card { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 0; min-height: 0; }
  .photo { min-height: 0; background: var(--paper-up); }
  .body { padding-top: 0.13in; }
  .card .label { margin: 0 0 0.05in; }
  .card h2 { font-size: 19pt; line-height: 1.02; letter-spacing: -0.02em; margin-bottom: 0.07in; }
  .summary { margin: 0 0 0.1in; }

  /* Measured results: one block per value, the last (the measured one) in graphite */
  .result { margin-bottom: 0.1in; }
  .result dl { display: grid; gap: 1px; }
  .result dl div { padding: 0.06in 0.1in 0.07in; background: var(--paper-up); }
  .result dl div:last-child { background: var(--graphite); }
  .result dl div:last-child dt { color: #a8a59e; }
  .result dl div:last-child dd { color: var(--paper); }
  .result dt { margin-bottom: 0.02in; }
  .result dd { font-family: var(--mono); font-size: 10.5pt; font-weight: 500; line-height: 1.2; color: var(--ink); font-variant-numeric: tabular-nums; }
  .result p { margin: 0.06in 0 0; font-size: 8.3pt; line-height: 1.4; color: var(--steel); }

  .highlights { margin-bottom: 0.1in; border-top: 1px solid var(--mist); }
  .highlights li { padding: 0.05in 0; border-bottom: 1px solid var(--mist); }
  .role { margin: 0 0 0.1in; font-size: 8.8pt; }
  .role strong { color: var(--ink); font-weight: 650; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.04in; }
  .tags li { font-family: var(--mono); font-size: 6.6pt; padding: 0.02in 0.06in; border: 1px solid var(--mist); color: var(--charcoal); }

  .more { border-top: 1px solid var(--ink); padding-top: 0.1in; }
  .more h2 { font-size: 13pt; letter-spacing: -0.01em; margin-bottom: 0.1in; display: flex; align-items: baseline; justify-content: space-between; }
  .more h2 a { font-family: var(--mono); font-size: 7pt; letter-spacing: 0.02em; color: var(--steel); }
  .more ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.24in; }
  .more li { font-size: 7.9pt; line-height: 1.4; }
  .more li a { display: block; font-weight: 650; color: var(--ink); font-size: 8.6pt; line-height: 1.25; margin-bottom: 0.04in; }

  footer {
    position: absolute;
    left: 0.5in;
    right: 0.5in;
    bottom: 0.24in;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  footer .mark { font-family: var(--font); font-size: 7pt; font-weight: 700; font-stretch: 125%; letter-spacing: 0.02em; color: var(--ink); }
</style>
